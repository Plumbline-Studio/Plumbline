{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/p/cortex", "destination": "/board" },
    { "source": "/p/:code/board", "destination": "/board" },
    { "source": "/p/:code", "destination": "/p" }
  ],
  "headers": [{ "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }]
}
